{
  "uid": "homelab-workloads",
  "title": "Homelab / Workloads & Storage",
  "description": "NamespaceごとのPod、再起動、CPU・メモリ、PVCの容量を調査。",
  "tags": [
    "homelab",
    "operations"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "Asia/Tokyo",
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "links": [
    {
      "title": "Overview",
      "url": "/d/homelab-overview",
      "type": "link",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "Workloads & Storage",
      "url": "/d/homelab-workloads",
      "type": "link",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "Logs & Events",
      "url": "/d/homelab-logs",
      "type": "link",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "AI Worker & Gateway",
      "url": "/d/homelab-ai-platform",
      "type": "link",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "PBS & Backups",
      "url": "/d/homelab-pbs",
      "type": "link",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    }
  ],
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "HOMELAB  /  WORKLOADS & STORAGE",
      "type": "text",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "データなし",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "**何が動いているか、どこが不安定か、容量は足りるか。**  \nNamespaceで絞り込み。容量はkubeletが取得するマウント済みPVCのファイルシステム使用量です。Longhornの物理ディスク使用量・レプリカ健全性は含みません。"
      }
    },
    {
      "id": 2,
      "title": "Running Pod",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "データなし",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_status_phase{namespace=~\"$namespace\",phase=\"Running\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "title": "非Ready Pod",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "データなし",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((kube_pod_status_ready{namespace=~\"$namespace\",condition=\"false\"} == 1) and on(namespace,pod) (kube_pod_status_phase{namespace=~\"$namespace\",phase!~\"Succeeded|Failed\"} == 1)) or (0 * sum(kube_pod_info{namespace=~\"$namespace\"}))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "title": "再起動 / 選択期間 (推定)",
      "type": "stat",
      "description": "Prometheus increase による推定回数。端点の補間を含む値を整数に丸めて表示。",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "データなし",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\"}[$__range]))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ]
    },
