# ===========================================================================
# Talos machine config パッチ — worker
#
# control-plane 用（controlplane.yaml.tftpl）との差分:
#   - VIP を持たない
#   - cluster.* の apiServer / etcd / admissionControl 等は設定しない
#     （worker ではこれらのコンポーネントが動かないため）
#
# ⚠️ interfaces はリスト全体が置換されるため、control-plane 用と共通化せず
#    それぞれのテンプレートで完全に記述している。部分的なマージに頼ると
#    片方の NIC 定義が消えるという分かりにくい事故が起きる。
# ===========================================================================
machine:
  nodeLabels:
    # node-role.kubernetes.io/* は Kubernetes の予約済みプレフィックスで、
    # worker 自身の kubelet からは付与できない。worker の役割は
    # control-plane ラベルを持たないことで Kubernetes が判定する。
    # ワークロード配置には、kubelet が安全に登録できる独自ラベルを使う。
    homelab.craftz.dev/workload-plane: "true"
    # Longhorn はこのラベルを持つノードだけに既定ディスクを作る。
    # これにより再構築後もcontrol-planeがstorage nodeへ戻らない。
    node.longhorn.io/create-default-disk: "true"

  install:
    disk: /dev/sda
    image: ${installer_image}
    wipe: false

  network:
    # ⚠️ hostname はここ（v1alpha1）には書かない。
    #    Talos v1.13 ではホスト名の設定が HostnameConfig ドキュメント
    #    （ファイル末尾）へ移行しており、併用すると
    #      "static hostname is already set in v1alpha1 config"
    #    で validate が失敗する。
    nameservers: ${nameservers}

    interfaces:
      # --- eth0 相当: VLAN40（Kubernetes 全般）---
      - deviceSelector:
          hardwareAddr: "${mac_k8s}"
        addresses:
          - ${ip}/24
        routes:
          - network: 0.0.0.0/0
            gateway: ${gateway}
        mtu: 1500
        dhcp: false

  time:
    disabled: false
    servers: ${ntp_servers}

  features:
    rbac: true
    # stableHostname は HostnameConfig と排他のため設定しない
    # （詳細は controlplane.yaml.tftpl のコメントを参照）
    apidCheckExtKeyUsage: true
    kubePrism:
      enabled: true
      port: 7445
    hostDNS:
      enabled: true
      forwardKubeDNSToHost: true

  # ディスク暗号化。worker の EPHEMERAL にはコンテナイメージと
  # emptyDir が置かれるため、control-plane と同様に暗号化する。
  systemDiskEncryption:
    state:
      provider: luks2
      keys:
        - nodeID: {}
          slot: 0
    ephemeral:
      provider: luks2
      keys:
        - nodeID: {}
          slot: 0

  kubelet:
    nodeIP:
      validSubnets:
        - ${k8s_subnet}
    extraArgs:
      rotate-server-certificates: "true"
    extraConfig:
      serverTLSBootstrap: true

    # -----------------------------------------------------------------------
    # Longhorn のデータパスを kubelet から見えるようにする
    #
    # Longhorn の manager / instance-manager は kubelet の mount namespace
    # を通してレプリカを読み書きする。rshared にしないと、Longhorn が
    # 作ったマウントが kubelet 側へ伝播せず、Pod がボリュームを
    # 見つけられない（原因が非常に分かりにくい失敗をする）。
    # -----------------------------------------------------------------------
    extraMounts:
      - destination: /var/mnt/longhorn
        type: bind
        source: /var/mnt/longhorn
        options:
          - bind
          - rshared
          - rw

  sysctls:
    net.ipv4.conf.all.log_martians: "1"
    fs.inotify.max_user_watches: "524288"
    fs.inotify.max_user_instances: "8192"

cluster:
  network:
    cni:
      name: none
    podSubnets:
      - ${pod_cidr}
    serviceSubnets:
      - ${service_cidr}

  proxy:
    disabled: true

  discovery:
    enabled: true
    registries:
      kubernetes:
        disabled: false
      service:
        disabled: true

---
# ===========================================================================
# ホスト名（Talos v1.13 以降の指定方法）
#
# 詳細は controlplane.yaml.tftpl 末尾のコメントを参照。
# ===========================================================================
apiVersion: v1alpha1
kind: HostnameConfig
# ---------------------------------------------------------------------------
# ホスト名（Talos v1.13 以降の指定方法）
#
# Talos v1.13 でホスト名の設定が v1alpha1 の machine.network.hostname から
# 独立した HostnameConfig ドキュメントへ移行した。
#
# ⚠️ `auto` と `hostname` の関係に注意:
#    `talosctl gen config`（および terraform-provider-talos）は既定で
#    `auto: stable` を出力する。ここで `hostname` だけを足すと
#      "HostnameConfig: 'auto' and 'hostname' cannot be set at the same time"
#    で validate に失敗する。`auto: off`（自動生成を止める）と併記して
#    初めて静的なホスト名を指定できる。
#
#    strategic merge patch では既存の `auto` を削除できないため
#    （`auto: null` も `$patch: replace` も効かないことを talosctl v1.13 で
#    実測確認済み）、値を `off` に上書きする形を取る。
#
# 検証コマンド:
#   talosctl -n <node> get hostnamestatus
# ---------------------------------------------------------------------------
auto: off
hostname: ${hostname}

---
# ===========================================================================
# Longhorn 用のデータボリューム
#
# ---------------------------------------------------------------------------
# なぜ専用ディスクを切り出すのか
# ---------------------------------------------------------------------------
# Longhorn の既定のデータパスは /var/lib/longhorn だが、Talos の /var は
# EPHEMERAL パーティション上にあり、再インストールや `talosctl reset` で
# 初期化される。そこにレプリカを置くと、ノードを 1 台作り直すたびに
# Longhorn が全レプリカを再同期することになる。
#
# VM に 2 本目のディスク（scsi1, serial=longhorn）を付け、
# UserVolumeConfig で /var/mnt/longhorn として独立させることで、
# OS のライフサイクルとデータのライフサイクルを分離する。
#
# ⚠️ この選択は serial では判定していない。実際の条件は `!system_disk`。
#    tofu/10-proxmox-talos/vms.tf の scsi1 には `serial = "longhorn"` が
#    付いているが、**ゲスト内の Talos はその serial を見ていない。**
#
#    2026-09-15 に Talos v1.13.9 上で実測した結果（worker-1）:
#
#      sda  60GiB   model="QEMU HARDDISK"  transport=virtio  serial: 無し
#           symlink /dev/disk/by-id/scsi-0QEMU_QEMU_HARDDISK_drive-scsi0
#      sdb 300GiB   model="QEMU HARDDISK"  transport=virtio  serial: 無し
#           symlink /dev/disk/by-id/scsi-0QEMU_QEMU_HARDDISK_drive-scsi1
#
#    serial フィールドは両方とも空で、by-id にも "longhorn" は現れない。
#    つまり `disk.serial == "longhorn"` に書き換えると**何にも一致せず
#    ボリュームが作られなくなる。** 確認コマンド:
#      talosctl -n <worker> get disks sdb -o yaml
# ===========================================================================
apiVersion: v1alpha1
kind: UserVolumeConfig
name: longhorn
provisioning:
  diskSelector:
    # ---------------------------------------------------------------------
    # システムディスク以外を選ぶ。
    #
    # ⚠️ この条件が一意なのは「VM のディスクが 2 本だけ」という前提に
    #    依存している（scsi0 = OS、scsi1 = Longhorn）。
    #    3 本目を追加すると system_disk 以外が 2 本になり、
    #    どちらが選ばれるか決まらない。さらに `grow: true` があるため、
    #    掴んだ側を残り全体まで広げようとする。
    #
    #    ディスクを追加する場合は、追加する前に条件を一意にすること。
    #    serial は使えない（上記の実測）。使える候補は
    #      - サイズ（下の minSize / maxSize）
    #      - disk.symlinks に含まれる drive-scsiN
    #    のいずれか。symlinks を使う CEL 式は導入バージョンで
    #    検証してから採用すること。
    # ---------------------------------------------------------------------
    match: '!system_disk'
  # 最小サイズ。これを下回るディスクしか無い場合はエラーになる
  # （意図しないディスクを掴む事故を防ぐガード）。
  #
  # ⚠️ ディスクを 3 本目に増やすときは、この値を 200GB へ上げること。
  #    DB 用に 64GiB のディスクを足すと `!system_disk` が 2 本に一致して
  #    しまうが、minSize が 50GB のままだと 64GiB のディスクも通過する。
  #    200GB なら 300GiB の Longhorn 用ディスクだけが残る。
  #
  #    2026-09-16 に一度 200GB へ変更したが差し戻した。理由は、
  #    ライブの Talos は 50GB のままで `tofu plan` も実行できず
  #    （state が暗号化されており passphrase が無い）、
  #    **適用されないまま宣言だけが食い違う状態**になったため。
  #    次に誰かが無関係な理由で apply したときに、意図せず 3 ノードの
  #    machine config が更新される。3 本目を足す予定が無い現状では
  #    利益が無く、リスクだけが残る。
  #
  #    上げるときは plan で「VM 置換・ディスク削除・意図しない Talos
  #    再適用や再起動が無い」ことを確認してから行うこと。
  minSize: 50GB
  # ディスクの残り全体まで広げる（実サイズは Proxmox 側の
  # longhorn_disk_gib で決まる）
  grow: true
filesystem:
  type: xfs
