  "panels": [
    {
      "id": 1,
      "title": "HOMELAB  /  CONTROL ROOM",
      "type": "text",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "データなし",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "**全体をつかむ → 異常を見つける → 詳細へ進む**　｜　Talos / Kubernetes　・　時刻: Asia/Tokyo  \n上のリンクからワークロード・容量・ログへ。Nodeフィルターはノード別グラフに適用され、上段のサマリーはクラスタ全体を表示します。"
      }
    },
    {
      "id": 2,
      "title": "Ready ノード",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "データなし",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "editorMode": "code",
          "instant": false,
          "range": true
        }
      ]
    },
