{
  "groups": {
    "group:funnel": ["craftzdev@github"],
  },

  "tagOwners": {
    "tag:ai-gateway": ["autogroup:admin"],
    "tag:k8s-operator": ["autogroup:admin"],
    "tag:ai-worker-trusted": ["autogroup:admin", "tag:k8s-operator"],
    "tag:ai-worker-sandbox": ["autogroup:admin"],
  },

  "grants": [
    // Preserve user-operated device access and the existing subnet-router use.
    {
      "src": ["autogroup:member"],
      "dst": ["autogroup:member"],
      "ip": ["*"],
    },
    {
      "src": ["autogroup:member"],
      "dst": ["172.16.10.0/24", "172.16.40.0/24"],
      "ip": ["*"],
    },
    // Tailnet users may open signed Worker review URLs over HTTPS. API routes
    // still require the separate Worker bearer token.
    {
      "src": ["autogroup:member"],
      "dst": ["tag:ai-worker-trusted"],
      "ip": ["tcp:443"],
    },

    // The tagged Gateway can only use HTTPS when talking to AI workers.
    {
      "src": ["tag:ai-gateway"],
      "dst": [
        "tag:ai-worker-trusted",
        "tag:ai-worker-sandbox",
      ],
      "ip": ["tcp:443"],
    },
    {
      "src": [
        "tag:ai-worker-trusted",
        "tag:ai-worker-sandbox",
      ],
      "dst": ["tag:ai-gateway"],
      "ip": ["tcp:443"],
    },
  ],

  "ssh": [
    {
      "action": "check",
      "src": ["autogroup:member"],
      "dst": ["autogroup:self"],
      "users": ["autogroup:nonroot", "root"],
    },
  ],

  "nodeAttrs": [
    {
      "target": ["group:funnel"],
      "attr": ["funnel"],
    },
  ],
}
