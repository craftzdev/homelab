        }
      },
      {
        "name": "loki",
        "type": "datasource",
        "query": "loki",
        "hide": 2,
        "current": {
          "text": "Loki",
          "value": "P8E80F9AEF21F6940"
        }
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
