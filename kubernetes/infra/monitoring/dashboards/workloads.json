    {
      "id": 9,
      "title": "CPU 使用量 Top 10 / Pod",
      "type": "bargauge",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
