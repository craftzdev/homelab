POSTGRES_PASSWORD=replace-with-random-value
GATEWAY_API_TOKEN=replace-with-random-value
WORKER_CALLBACK_TOKEN=replace-with-different-random-value
WORKER_BASE_URL=https://ai-worker-k8s.example-tailnet.ts.net
WORKER_API_TOKEN=replace-with-worker-api-token
# The human's own credential: required to accept or reject a deliverable, and for
# production approval. The Control Plane holds it server-side for those commands.
HUMAN_APPROVAL_TOKEN=replace-with-human-only-random-value
# Server-side identity of the single human who owns the above token; never share it.
HUMAN_APPROVAL_ACTOR=craftz
# Separate credential for configuration drafts; never give it to Grok.
# Empty disables all configuration writes. Use 32+ random characters when enabled.
CONFIG_ADMIN_TOKEN=
CONFIG_ADMIN_ACTOR=
CONFIG_CONTROLLER_TOKEN=
# The Agent Workflow Controller's own credential for the internal workflow API.
# Leave empty to keep that API disabled; it must never be shared with Grok or a
# browser, and the endpoint belongs on the internal network only.
CONTROLLER_API_TOKEN=replace-with-controller-only-random-value
# Fixed trusted ComfyUI service. Set empty explicitly to disable video generation.
COMFYUI_BASE_URL=https://omen45.tailb6c7d.ts.net:8443
CLOUDFLARE_ACCESS_REQUIRED=false
CLOUDFLARE_ACCESS_TEAM_DOMAIN=replace-with-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=replace-with-access-application-audience
