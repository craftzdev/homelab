{
  "uid": "homelab-logs",
  "title": "Homelab / Logs & Events",
  "description": "Podログ、Kubernetes Events、監査ログを横断して調査。",
  "tags": [
    "homelab",
    "operations"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "Asia/Tokyo",
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "links": [
    {
      "title": "Overview",
      "url": "/d/homelab-overview",
      "type": "link",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "Workloads & Storage",
      "url": "/d/homelab-workloads",
      "type": "link",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "Logs & Events",
      "url": "/d/homelab-logs",
      "type": "link",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "AI Worker & Gateway",
      "url": "/d/homelab-ai-platform",
      "type": "link",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "PBS & Backups",
      "url": "/d/homelab-pbs",
      "type": "link",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    }
  ],
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "HOMELAB  /  LOG EXPLORER",
      "type": "text",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "データなし",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "**異常の前後を、ログからたどる。**  \nNamespace → Pod → 検索語の順で絞り込み。Podログは最新200行。EventsはNamespace、監査ログはクラスタ全体が対象です（Podフィルターは適用しません）。"
      }
    },
    {
      "id": 2,
      "title": "ログ流量 / Namespace",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "データなし",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false,
            "axisColorMode": "text",
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace)(rate({cluster=\"homelab\",namespace=~\"$namespace\",pod=~\"$pod\",job!~\"kubernetes/events|kubernetes/audit\"} |= ${search:doublequote}[$__auto]))",
          "legendFormat": "{{namespace}}",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "instant": false,
          "range": true,
          "queryType": "range",
          "maxLines": 200
        }
      ]
    },
    {
      "id": 3,
      "title": "エラー候補 / Namespace",
      "type": "timeseries",
      "description": "文字列による候補抽出。構造化された重要度判定ではありません。",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "データなし",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false,
            "axisColorMode": "text",
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace)(count_over_time({cluster=\"homelab\",namespace=~\"$namespace\",pod=~\"$pod\",job!~\"kubernetes/events|kubernetes/audit\"} |= ${search:doublequote} |~ \"(?i)(error|fatal|panic|exception)\" [$__auto]))",
          "legendFormat": "{{namespace}}",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "instant": false,
          "range": true,
          "queryType": "range",
          "maxLines": 200
        }
      ]
    },
    {
      "id": 4,
      "title": "Pod ログ",
      "type": "logs",
      "description": "最新200行。詳細を開くとNamespace・Pod・コンテナを確認できます。",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 13
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "データなし",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{cluster=\"homelab\",namespace=~\"$namespace\",pod=~\"$pod\",job!~\"kubernetes/events|kubernetes/audit\"} |= ${search:doublequote}",
          "legendFormat": "",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "instant": false,
          "range": true,
          "queryType": "range",
          "maxLines": 200
        }
      ]
    },
    {
      "id": 5,
      "title": "Kubernetes Warning Events",
      "type": "logs",
      "description": "Namespaceで絞り込み。該当するWarningが無い期間は空欄。",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "データなし",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{cluster=\"homelab\",job=\"kubernetes/events\",namespace=~\"$namespace\"} | logfmt | type=\"Warning\" |= ${search:doublequote}",
          "legendFormat": "",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "instant": false,
          "range": true,
          "queryType": "range",
          "maxLines": 200
        }
      ]
    },
    {
      "id": 6,
      "title": "Kubernetes Events",
      "type": "logs",
      "description": "通常イベントも含む。Podフィルターは適用しません。",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "データなし",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{cluster=\"homelab\",job=\"kubernetes/events\",namespace=~\"$namespace\"} |= ${search:doublequote}",
          "legendFormat": "",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "instant": false,
          "range": true,
          "queryType": "range",
          "maxLines": 200
        }
      ]
    },
    {
      "id": 7,
      "title": "Kubernetes 監査ログ / Cluster",
      "type": "logs",
      "description": "クラスタ全体の監査ログ。検索語のみ適用。Namespace / Pod変数では絞り込みません。",
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "データなし",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{cluster=\"homelab\",log_class=\"audit\"} |= ${search:doublequote}",
          "legendFormat": "",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "instant": false,
          "range": true,
          "queryType": "range",
          "maxLines": 200
        }
      ]
    }
  ],
  "templating": {
