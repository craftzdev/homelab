      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "noValue": "データなし",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
