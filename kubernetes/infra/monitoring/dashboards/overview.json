    {
      "id": 14,
      "title": "発火中のアラート",
      "type": "table",
      "description": "Watchdog / InfoInhibitorを除外。空欄は該当なし。通知先は別設定です。",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 14,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "データなし",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\",alertname!~\"Watchdog|InfoInhibitor\"}",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "alertname",
                "severity",
                "namespace",
                "pod",
                "short",
                "long"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "alertname": 0,
              "severity": 1,
              "namespace": 2,
              "pod": 3,
              "short": 4,
              "long": 5
            },
            "renameByName": {
              "alertname": "アラート",
              "severity": "重要度",
              "namespace": "Namespace",
              "pod": "Pod",
