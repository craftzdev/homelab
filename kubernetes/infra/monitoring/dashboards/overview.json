  "tags": [
    "homelab",
    "operations"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "Asia/Tokyo",
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "links": [
    {
      "title": "Overview",
      "url": "/d/homelab-overview",
      "type": "link",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "Workloads & Storage",
      "url": "/d/homelab-workloads",
      "type": "link",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "Logs & Events",
      "url": "/d/homelab-logs",
      "type": "link",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "AI Worker & Gateway",
      "url": "/d/homelab-ai-platform",
      "type": "link",
      "keepTime": true,
