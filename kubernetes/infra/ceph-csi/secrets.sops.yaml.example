# ===========================================================================
# Ceph の認証情報（テンプレート）
#
# 実物（secrets.sops.yaml）は scripts/ceph-create-k8s-user.sh が
# Ceph 上にユーザーを作成した上で生成し、SOPS + age で暗号化する。
#
# ⚠️ このファイルを埋めてリネームしないこと。必ずスクリプトを使う。
#
# ⚠️⚠️ ここに client.admin のキーを入れてはならない。
#      admin キーを渡すと、Kubernetes の侵害が即座に
#      「Proxmox VM のディスク（cephrdb_vm）を破壊できる」状態に直結する。
#      docs/30-storage-design.md §4 を参照。
# ===========================================================================
---
apiVersion: v1
kind: Secret
metadata:
  name: csi-rbd-secret
  namespace: ceph-csi
type: Opaque
stringData:
  # ceph auth get-or-create client.k8s-rbd \
  #   mon 'profile rbd' \
  #   osd 'profile rbd pool=cephrdb_k8s' \
  #   mgr 'profile rbd pool=cephrdb_k8s'
  userID: k8s-rbd
  userKey: "REPLACE_ME"

---
apiVersion: v1
kind: Secret
metadata:
  name: csi-cephfs-secret
  namespace: ceph-csi
type: Opaque
stringData:
  # ceph auth get-or-create client.k8s-cephfs \
  #   mon 'allow r fsname=cephfs01' \
  #   mds 'allow rw fsname=cephfs01 path=/volumes/csi' \
  #   osd 'allow rw tag cephfs data=cephfs01' \
  #   mgr 'allow rw'
  userID: k8s-cephfs
  userKey: "REPLACE_ME"
  # CephFS の provisioner は adminID/adminKey という名前のキーも参照する。
  # ここでは同じ最小権限ユーザーを指す（admin ではない）。
  adminID: k8s-cephfs
  adminKey: "REPLACE_ME"
