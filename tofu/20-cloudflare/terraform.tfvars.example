# ===========================================================================
# terraform.tfvars.example  (tofu/20-cloudflare)
#
#   cp terraform.tfvars.example terraform.tfvars
#
# ⚠️ cloudflare_api_token は機密。tfvars に書かず環境変数で渡すことを推奨:
#      export TF_VAR_cloudflare_api_token='...'
# ===========================================================================

# ---------------------------------------------------------------------------
# Cloudflare 認証
#
# API トークンは以下の最小権限で作成する（Global API Key は使わない）:
#   Account | Cloudflare Tunnel         | Edit
#   Account | Access: Apps and Policies | Edit
#   Account | Access: Service Tokens    | Edit
#   Zone    | DNS                       | Edit  （対象ゾーンのみ）
# ---------------------------------------------------------------------------
cloudflare_api_token  = "REPLACE_ME"
cloudflare_account_id = "REPLACE_ME"
cloudflare_zone_id    = "REPLACE_ME"

# Zero Trust の team name（<team>.cloudflareaccess.com の <team> 部分）。
# Zero Trust ダッシュボード → Settings → Custom Pages で確認できる。
cloudflare_team_name = "REPLACE_ME"

# ---------------------------------------------------------------------------
# トンネル
# ---------------------------------------------------------------------------
tunnel_name = "homelab-k8s"

# ---------------------------------------------------------------------------
# Service Token
# ---------------------------------------------------------------------------
service_token_name     = "saas-worker"
service_token_duration = "2160h" # 90 日。期限前にローテーションすること。

# この数値を +1 して apply するとシークレットがローテーションされる
service_token_secret_version = 0

# ---------------------------------------------------------------------------
# 公開するサービス
#
# ⚠️ ここに追加することは「インターネットからアクセス可能にする」ことを意味する。
#    docs/40-external-access.md §7 の選定基準を満たすもののみ追加すること。
#    管理平面（Kubernetes API / ArgoCD / Proxmox / Talos）は絶対に追加しない。
# ---------------------------------------------------------------------------
published_services = {
  "internal-api" = {
    hostname       = "api.internal.example.com"
    origin_service = "http://cilium-gateway-external.gateway.svc.cluster.local:80"
    # Access のセッション有効期間。API 用途なので短めにする。
    session_duration = "30m"

    # Gatus に監視させる health endpoint。
    #
    # ⚠️ 指定すると、このパスだけを対象にした専用の Access アプリケーションが
    #    作られ、Gatus のトークンだけを許可する。監視トークンを上の
    #    アプリケーションのポリシーへ足してはならない。Access はホスト名
    #    単位で効くため、監視トークンが全パスへ到達できるようになる。
    #
    #    「プロセスが生きているか」ではなく「依存先まで健全か」を返す
    #    パスを選ぶこと。/health より /ready のほうが適していることが多い。
    health_path = "/ready"
  }

  # 追加例:
  # "reports" = {
  #   hostname       = "reports.internal.example.com"
  #   origin_service = "http://cilium-gateway-external.gateway.svc.cluster.local:80"
  # }
}

# ---------------------------------------------------------------------------
# 匿名公開するサービス
#
# ⚠️ published_services とは意味が違う。ここに書いたホスト名には
#    Cloudflare Access が **一切付かない**。認証なしで世界中から到達できる。
#    WAF / DDoS 保護 / ボット対策は proxied = true により効くが、
#    「誰がアクセスしてよいか」の制御は無い。
#
#    一般公開の Web サイトだけを書くこと。内部 API を誤ってここへ書くと
#    無防備に公開される。変数を分けてあるのはその取り違えを防ぐためである。
#
# moshitoku.com は point-guide アプリの一般公開サイトである。
# apex と www の両方を登録する。cloudflared の ingress ルールと
# DNS レコードはこの定義から生成される。
# ---------------------------------------------------------------------------
public_services = {
  "moshitoku" = {
    hostname       = "moshitoku.com"
    origin_service = "http://cilium-gateway-external.gateway.svc.cluster.local:80"
  }

  "moshitoku-www" = {
    hostname       = "www.moshitoku.com"
    origin_service = "http://cilium-gateway-external.gateway.svc.cluster.local:80"
  }
}
