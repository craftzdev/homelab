# ===========================================================================
# cloudflared の Tunnel 認証情報（テンプレート）
#
# このファイルは「暗号化前の形」を示すサンプルである。
# 実物（credentials.sops.yaml）は scripts/sync-cloudflare-secrets.sh が
# tofu の出力から生成し、SOPS + age で暗号化する。
#
# ⚠️ このファイルを埋めて credentials.sops.yaml にリネームしないこと。
#    平文のままコミットされる事故につながる。必ずスクリプトを使う。
#
# 暗号化後は data フィールドのみが暗号文になり、
# apiVersion / kind / metadata は平文のまま残る（.sops.yaml の
# encrypted_regex による）。これにより差分レビューが可能になる。
# ===========================================================================
apiVersion: v1
kind: Secret
metadata:
  name: cloudflared-credentials
  namespace: cloudflared
type: Opaque
stringData:
  # cloudflared が読み込む credentials.json の中身。
  #   {"AccountTag":"...","TunnelID":"...","TunnelName":"...","TunnelSecret":"..."}
  credentials.json: "REPLACE_ME"
